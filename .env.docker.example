# Para docker compose (copie para .env na raiz e preencha)
DB_PASSWORD=troque-por-uma-password-forte
# pelo menos 32 caracteres aleatórios (ex.: openssl rand -base64 48)
JWT_SECRET=
# Primeira conta de Direção (só é usada se ainda não existir nenhum utilizador)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Direção
