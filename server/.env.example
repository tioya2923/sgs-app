# Base de dados PostgreSQL
DATABASE_URL=postgresql://postgres@127.0.0.1:5545/sgs
# Segredo do JWT de acesso (>= 32 caracteres, aleatório em produção)
JWT_SECRET=troque-isto-por-um-segredo-longo-e-aleatorio-123456
# Origens autorizadas (CORS), separadas por vírgula
CORS_ORIGINS=http://localhost:5173,https://tioya2923.github.io
PORT=3300
NODE_ENV=development
# Password inicial das contas de demonstração (só seed)
SEED_PASSWORD=Demo-Sgs-2026!

# --- Produção (ver DEPLOY.md) ---
# Pasta do frontend compilado: se definida, a API serve também a aplicação
# FRONTEND_DIR=../dist
# Atrás de um proxy HTTPS (Render, Caddy, nginx)
# TRUST_PROXY=true
# Primeira conta de Direção (só se ainda não existirem utilizadores)
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_NAME=Direção
